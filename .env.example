# Skopiuj do .env i ustaw wlasne hasla przed pierwszym uruchomieniem.
APP_PORT=8080

POSTGRES_DB=anivibe
POSTGRES_USER=anivibe
POSTGRES_PASSWORD=change_this_local_database_password
# Port na komputerze; PHP w sieci Dockera zawsze uzywa db:5432.
POSTGRES_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_this_local_pgadmin_password
PGADMIN_PORT=5050
PGADMIN_CONTAINER_NAME=anivibe-pgadmin

MAILPIT_PORT=8025
