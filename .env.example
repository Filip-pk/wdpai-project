# Skopiuj do .env i ustaw wlasne hasla przed pierwszym uruchomieniem.
APP_PORT=8080
# HTTP na APP_PORT przekierowuje na HTTPS pod tym portem.
APP_HTTPS_PORT=8443

POSTGRES_DB=anivibe
POSTGRES_USER=anivibe
POSTGRES_PASSWORD=change_this_local_database_password
# Port na komputerze; PHP w sieci Dockera zawsze uzywa db:5432.
POSTGRES_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_this_local_pgadmin_password
PGADMIN_PORT=5050
PGADMIN_CONTAINER_NAME=anivibe-pgadmin

MAILPIT_PORT=8025

# Poczta wychodzaca. Lokalnie przechwytuje ja Mailpit w sieci Dockera.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@anivibe.local
MAIL_FROM_NAME=AniVibe

# Czat katalogowy /chat. Model pobierasz poleceniem z docs/catalog-chat.md.
OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b
